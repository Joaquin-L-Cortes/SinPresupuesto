rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Perfiles de usuario ──────────────────────────────────
    match /usuarios/{userId} {
      // Cada usuario lee y escribe solo su propio perfil
      allow read, write: if request.auth != null && request.auth.uid == userId;
      // El admin puede leer todos los perfiles
      allow read: if request.auth != null && request.auth.uid == 'Yx6LxvfXOZQMBU9nxszWZN3mtrz1';

      // ── Progreso por sección (subcolección) ───────────────
      match /progress/{pageKey} {
        // Solo el propio usuario puede leer y escribir su progreso
        allow read, write: if request.auth != null && request.auth.uid == userId;
        // El admin puede leer el progreso de cualquier usuario
        allow read: if request.auth != null && request.auth.uid == 'Yx6LxvfXOZQMBU9nxszWZN3mtrz1';
      }
    }

    // Bloquear todo lo demás explícitamente
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
